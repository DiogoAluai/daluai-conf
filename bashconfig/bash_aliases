# ########## daluai-conf #########
# ############# BEGIN ############

# stronger clear, to work in other terminals such as kitty
alias clear="printf '\033[2J\033[3J\033[1;1H'"

# utils
alias ltr="ls -ltr"
alias ll="ls -AlF"
alias la="ls -A"
alias l="ls -CF"
alias o="xdg-open"
alias env="(env | sed 's/=/ = /g')" # make env print extra spaces for easier copy paste
alias wh="which"
alias where="type"     # "type" is amazing, it tells you more than "which". Let's not override "which" because some scripts may use it
alias calculator="bc"

alias python="python3"
alias nanol="nano --rcfile ~/.config/nano/nanorc-nolinenumbers"
alias naon="nano"
alias nv="nvim"
alias vn="nvim"
alias nvd="NVIM_DEBUUG=true nvim"
alias vnd="NVIM_DEBUUG=true nvim"
alias spgt="sgpt"

alias wifils="nmcli device wifi list"  # cool wifi list

# scripts
alias script_build="build_script"
alias cx="chmod +x"

# .bash editing
alias brc="nvim $HOME/.bashrc"
alias bal="nvim $HOME/.bash_aliases"
alias balias="bal"
alias bra="bal"
alias benv="nvim $HOME/.bash_envs"
alias bre="benv"
alias bprompt="nvim $HOME/.bash_prompt"

# ########## daluai-conf #########
# ############## END #############

